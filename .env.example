# Copy to .env.local (not committed) before building for a store. The store comes from VITE_STORE: bazaar (default) or myket.
# Set that one in the shell (VITE_STORE=myket npm run build): vite.config.js reads it before the .env files load.
# Public RSA key of the app: Bazaar developer panel -> your app -> in-app billing ("کلید RSA").
VITE_BAZAAR_RSA_KEY=
# Your developer id in the Bazaar panel (Settings -> More games).
VITE_BAZAAR_DEVELOPER_ID=
# Public billing key of the app: Myket developer panel -> your app ("کلید عمومی پرداخت").
VITE_MYKET_PUBLIC_KEY=

# Web client credentials. Android release builds read METRIX_APP_ID and METRIX_API_KEY from Gradle's environment.
VITE_METRIX_APP_ID=
VITE_METRIX_API_KEY=
